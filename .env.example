# Copie para .env e preencha com os dados do app Web no Firebase Console.
# Essas variáveis são incluídas no bundle do navegador; proteja os dados com as
# Firebase Realtime Database Security Rules, não tratando a API key como senha.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
